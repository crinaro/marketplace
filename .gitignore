# macOS
.DS_Store

# ⭐ GENERATED ARTIFACTS ARE NOT ENGINE. `dashboard.html` and `dashboard_artifact.html` are
# rendered FROM a profile's own data, so a committed copy is one person's pipeline — companies,
# contacts, comp — shipped inside the engine to everyone who installs it. Two were tracked here
# until 2026-08-09.
dashboard.html
dashboard_artifact.html
dashboard_artifact_url.txt

# Python
__pycache__/
*.pyc

# Local pointers and logs — machine-specific by definition
*.log
.claude/settings.local.json

# `claude plugin eval` writes timestamped run output here — generated, never source (dev #467).
plugins/*/evals/results/

# Worktrees Claude Code creates for sessions and isolated subagents (dev #616).
# ⚠️ These land INSIDE the repository, so without this line a fresh clone reads every
# harness-made worktree as untracked and the checkout as DIRTY — which the release preflight
# refuses outright, and which reads to any maintenance agent as "another writer holds this
# tree". It was ignored only in .git/info/exclude — machine-local and never
# version-controlled — until this line, so the whole workflow was author-only.
.claude/worktrees/
